{
    "name": "kingmaker/filament-filter-sets",
    "description": "Predefined filter sets for Filament tables — apply a combination of table filters in one click.",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "tables",
        "filters",
        "filter-sets"
    ],
    "homepage": "https://github.com/kingmaker-agm/filament-filter-sets",
    "type": "library",
    "license": "MIT",
    "version": "1.1.0",
    "authors": [
        {
            "name": "Kingmaker",
            "email": "pratheep@kingmaker.co.in",
            "homepage": "https://kingmaker.co.in"
        }
    ],
    "support": {
        "issues": "https://github.com/kingmaker-agm/filament-filter-sets/issues",
        "source": "https://github.com/kingmaker-agm/filament-filter-sets"
    },
    "require": {
        "php": "^8.2",
        "filament/tables": "^4.0|^5.0",
        "illuminate/contracts": "^11.28|^12.0|^13.0",
        "livewire/livewire": "^3.5|^4.0"
    },
    "require-dev": {
        "filament/filament": "^4.0|^5.0",
        "laravel/pint": "^1.16",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Kingmaker\\Filament\\FilterSets\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kingmaker\\Filament\\FilterSets\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kingmaker\\Filament\\FilterSets\\FilterSetsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
